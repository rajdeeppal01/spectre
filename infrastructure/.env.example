# ============================================================
# SPECTRE Environment Configuration
# Copy this file to .env and fill in your values
# NEVER commit .env to git
# ============================================================

# ── REQUIRED ─────────────────────────────────────────────────

# Your Google AI Studio API key (from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Master key for LiteLLM ↔ Open WebUI authentication
# Set this to any strong random string (e.g. run: openssl rand -hex 32)
LITELLM_MASTER_KEY=spectre-change-this-key

# ── OPTIONAL ─────────────────────────────────────────────────

# IBM Quantum API token (for real quantum hardware via Qiskit)
# Get from: https://quantum.ibm.com/
IBM_QUANTUM_TOKEN=

# ANU QRNG API (no key required — public free endpoint)
# https://qrng.anu.edu.au/

# ── ROUTING MODE ─────────────────────────────────────────────
# auto   = smart routing based on task type (recommended)
# online = force all non-security requests to Gemini Pro
# offline = force all requests to local models
SPECTRE_ROUTING_MODE=auto
